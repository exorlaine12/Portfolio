@model List<portfolio.Models.Course>
@{
    ViewData["Title"] = "Courses";
}
<section class="page-banner"><div class="container"><p class="eyebrow">MY LEARNING JOURNEY</p><h1>Courses</h1><p>Subjects and learning experiences that shaped my skills.</p></div></section>
<section class="container section-block">
    <div class="section-heading"><h2>Course list</h2><a class="btn btn-primary-custom" asp-action="Create">+ Add course</a></div>
    @if (TempData["Error"] is string error)
    {
        <div class="alert alert-warning">@error</div>
    }
    @if (!Model.Any())
    {
        <div class="empty-state">No courses found. Add your first course.</div>
    }
    else
    {

        <div class="table-responsive soft-panel">
            <table class="table align-middle mb-0">
                <thead><tr><th>Code</th><th>Course name</th><th>Semester</th><th>Academic year</th><th class="text-end">Actions</th></tr></thead>
                <tbody>
                    @foreach (var c in Model)
                    {
                        <tr><td><span class="code-pill">@c.Code</span></td><td><strong>@c.Name</strong><div class="muted-small">@c.Description</div></td><td>@c.Semester</td><td>@c.AcademicYear</td><td class="text-end"><a class="btn btn-sm btn-light" asp-action="Edit" asp-route-id="@c.CourseId">Edit</a> <form class="d-inline" asp-action="Delete" asp-route-id="@c.CourseId" method="post" onsubmit="return confirm('Delete this course? Courses with projects cannot be deleted.');"><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
